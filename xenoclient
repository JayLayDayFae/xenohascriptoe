local function addSlider(page, label, minV, maxV, default, callback, step, suffix)
	step = step or 1
	local function fmt(v)
		local s = step < 1 and string.format("%.2f", v) or tostring(v)
		return s .. (suffix or "")
	end

	local row = create("Frame", {
		LayoutOrder = nextOrder(page),
		Size = UDim2.new(1, 0, 0, 56),
		BackgroundColor3 = THEME.Item,
		BorderSizePixel = 0,
	}, { corner(10) })
	row.Parent = page

	create("TextLabel", {
		Position = UDim2.fromOffset(14, 8),
		Size = UDim2.new(1, -110, 0, 18),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		Text = label,
		TextColor3 = THEME.Text,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
	}).Parent = row

	local valueLabel = create("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 8),
		Size = UDim2.fromOffset(90, 18),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = fmt(default),
		TextColor3 = THEME.Accent,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	valueLabel.Parent = row

	local function toValue(a)
		local v = minV + a * (maxV - minV)
		v = math.floor(v / step + 0.5) * step
		return math.clamp(v, minV, maxV)
	end

	makeSlider(row, UDim2.fromOffset(14, 38), UDim2.new(1, -28, 0, 10),
		(default - minV) / (maxV - minV),
		function(a)
			local v = toValue(a)
			valueLabel.Text = fmt(v)
			callback(v)
		end, { Fill = true })
end

