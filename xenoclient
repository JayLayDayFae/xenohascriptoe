local function createTracked(character, settings, plr)
	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then return nil end
	local head = character:FindFirstChild("Head") or root

	local e = { Character = character, Humanoid = humanoid, Root = root, Settings = settings }

	e.Highlight = create("Highlight", {
		Name = "Kseno_ESP",
		Adornee = character,
		FillColor = settings.Color,
		FillTransparency = settings.Transparency,
		OutlineTransparency = 1,
		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
		Enabled = S.esp.Highlight,
		Parent = character,
	})
	e.HealthGui, e.HealthFill = makeHealthBar(root)
	e.InfoGui, e.NameLabel, e.DistLabel = makeInfoBar(head, plr)
	e.Tracer = makeTracer()
	return e
end

local function countActive()
	local n = 0
	for _ in pairs(activeTeams) do n += 1 end
	return n
end

local function countTracked()
	local n = 0
	for _ in pairs(tracked) do n += 1 end
	return n
end

local function scan()
	local activeCount = countActive()
	for _, plr in ipairs(Players:GetPlayers()) do
		local character = plr.Character
		local team = plr.Team
		-- Highlight everyone if no teams are applied/selected, otherwise check team filter
		local should = (plr ~= player or HIGHLIGHT_SELF)
			and character ~= nil and (activeCount == 0 or (team ~= nil and activeTeams[team] == true))

		if should then
			local settings = (activeCount == 0 and team == nil) and { Color = DEFAULT_HIGHLIGHT_COLOR, Transparency = DEFAULT_FILL_TRANSPARENCY } or getSettings(team or player.Team)
			local e = tracked[plr]
			local valid = e
				and e.Character == character
				and e.Highlight.Parent ~= nil
				and e.HealthGui.Parent ~= nil
				and e.InfoGui.Parent ~= nil

			if not valid then
				removeTracked(plr)
				e = createTracked(character, settings, plr)
				tracked[plr] = e
			end
			if e then
				e.Settings = settings
			end
		else
			removeTracked(plr)
		end
	end

	for plr in pairs(tracked) do
		if not plr.Parent then removeTracked(plr) end
	end

	if statusLabel then
		local c = countTracked()
		if activeCount == 0 then
			statusLabel.Text = string.format("Tracking %d player%s (All Mode)  •  scan every %ds", c, c == 1 and "" or "s", SCAN_INTERVAL)
		else
			statusLabel.Text = string.format("Tracking %d player%s  •  %d team%s  •  scan every %ds",
				c, c == 1 and "" or "s", activeCount, activeCount == 1 and "" or "s", SCAN_INTERVAL)
		end
		statusLabel.TextColor3 = c > 0 and THEME.Accent or THEME.SubText
	end
end

local function updateEsp()
	local cam = workspace.CurrentCamera
	if not cam then return end
	local camPos = cam.CFrame.Position
	local E = S.esp

	for _, e in pairs(tracked) do
		local hum, root = e.Humanoid, e.Root
		if hum.Parent and root.Parent then
			local settings = e.Settings

			e.Highlight.Enabled = E.Highlight
			e.Highlight.FillColor = settings.Color
			e.Highlight.FillTransparency = settings.Transparency

			local frac = hum.MaxHealth > 0 and math.clamp(hum.Health / hum.MaxHealth, 0, 1) or 0
			e.HealthGui.Enabled = E.Health
			e.HealthFill.Size = UDim2.fromScale(1, frac)
			e.HealthFill.BackgroundColor3 = Color3.fromHSV(frac * 0.33, 0.85, 1)

			e.NameLabel.Visible = E.Names
			e.NameLabel.TextColor3 = settings.Color

			local parts = {}
			if E.Distance then
				table.insert(parts, string.format("%d studs", math.floor((root.Position - camPos).Magnitude + 0.5)))
			end
			if E.Health then
				table.insert(parts, string.format("%d HP", math.ceil(hum.Health)))
			end
			e.DistLabel.Visible = #parts > 0
			e.DistLabel.Text = table.concat(parts, "  |  ")
			e.InfoGui.Enabled = E.Names or #parts > 0
		end
	end
end

local function updateTracers()
	local cam = workspace.CurrentCamera
	if not cam then return end
	local vp = cam.ViewportSize
	local mode = S.esp.TracerOrigin
	local origin
	if mode == "Bottom" then
		origin = Vector2.new(vp.X / 2, vp.Y)
	elseif mode == "Center" then
		origin = Vector2.new(vp.X / 2, vp.Y / 2)
	elseif mode == "Top" then
		origin = Vector2.new(vp.X / 2, 0)
	else
		origin = UserInputService:GetMouseLocation()
	end

	for _, e in pairs(tracked) do
		local line = e.Tracer
		if S.esp.Tracers and e.Root.Parent and e.Humanoid.Health > 0 then
			local p = cam:WorldToViewportPoint(e.Root.Position)
			local dx, dy = p.X - origin.X, p.Y - origin.Y
			if p.Z < 0 then dx, dy = -dx, -dy end
			local len = math.sqrt(dx * dx + dy * dy)
			line.BackgroundColor3 = e.Settings.Color
			line.Size = UDim2.fromOffset(len, 1.5)
			line.Position = UDim2.fromOffset(origin.X + dx / 2, origin.Y + dy / 2)
			line.Rotation = math.deg(math.atan2(dy, dx))
			line.Visible = len > 1
		else
			line.Visible = false
		end
	end
end

local function applyTeamStyle(team)
	local s = getSettings(team)
	for plr, e in pairs(tracked) do
		if plr.Team == team then
			e.Settings = s
			e.Highlight.FillColor = s.Color
			e.Highlight.FillTransparency = s.Transparency
		end
	end
end

local function startScanning()
	scanToken += 1
	local myToken = scanToken
	task.spawn(function()
		while scanToken == myToken do
			scan()
			task.wait(SCAN_INTERVAL)
		end
	end)
	task.spawn(function()
		while scanToken == myToken do
			updateEsp()
			task.wait(UPDATE_INTERVAL)
		end
	end)
end

local function stopScanning()
	scanToken += 1
	clearAllTracked()
	if statusLabel then
		statusLabel.Text = "Not tracking"
		statusLabel.TextColor3 = THEME.SubText
	end
end

