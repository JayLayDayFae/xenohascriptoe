local function getSettings(team)
	if not team then
		return { Color = DEFAULT_HIGHLIGHT_COLOR, Transparency = DEFAULT_FILL_TRANSPARENCY }
	end
	local s = teamSettings[team]
	if not s then
		s = { Color = DEFAULT_HIGHLIGHT_COLOR, Transparency = DEFAULT_FILL_TRANSPARENCY }
		teamSettings[team] = s
	end
	return s
end

