		create("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 12, 0, ROW_HEIGHT / 2),
			Size = UDim2.fromOffset(24, 24),
			BackgroundColor3 = team.TeamColor.Color,
			BorderSizePixel = 0,
		}, { round(), stroke(Color3.new(1, 1, 1), 1, 0.7) }).Parent = row

		create("TextLabel", {
