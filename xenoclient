local aimHeld = false
local aimTarget = nil
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

UserInputService.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then aimHeld = true end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then aimHeld = false end
end)

local function getAimPart(char)
	local choice = S.aim.Part
	if choice == "Head" then
		return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
	elseif choice == "Torso" then
		return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
	end
	return char:FindFirstChild("HumanoidRootPart")
end

local function isValidTarget(plr)
	if plr == player then return false end
	local char = plr.Character
	if not char then return false end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return false end
	if S.aim.TeamCheck and player.Team ~= nil and plr.Team == player.Team then return false end
	if S.aim.OnlyEspTeams and not tracked[plr] then return false end
	return true, char
end

local function isVisible(cam, part, char)
	rayParams.FilterDescendantsInstances = { player.Character, char }
	local origin = cam.CFrame.Position
	return workspace:Raycast(origin, part.Position - origin, rayParams) == nil
end

local function screenDistance(cam, part, center)
	local p = cam:WorldToViewportPoint(part.Position)
	if p.Z <= 0 then return nil end
	return (Vector2.new(p.X, p.Y) - center).Magnitude
end

local function findTarget(cam, center, radius)
	local best, bestDist
	for _, plr in ipairs(Players:GetPlayers()) do
		local ok, char = isValidTarget(plr)
		if ok then
			local part = getAimPart(char)
			if part and (part.Position - cam.CFrame.Position).Magnitude <= S.aim.MaxDist then
				local d = screenDistance(cam, part, center)
				if d and d <= radius and (not bestDist or d < bestDist) then
					if not S.aim.WallCheck or isVisible(cam, part, char) then
						best, bestDist = plr, d
					end
				end
			end
		end
	end
	return best
end

RunService:BindToRenderStep("KsenoAimbot", Enum.RenderPriority.Camera.Value + 1, function(dt)
	local cam = workspace.CurrentCamera
	if not cam then return end

	fovCircle.Visible = S.aim.Enabled and S.aim.ShowFOV
	fovCircle.Size = UDim2.fromOffset(S.aim.FOV * 2, S.aim.FOV * 2)

	local active = S.aim.Enabled and (S.aim.Mode == "Always On" or aimHeld)
	if not active then
		aimTarget = nil
		return
	end

	local vp = cam.ViewportSize
	local center = Vector2.new(vp.X / 2, vp.Y / 2)
	local radius = S.aim.FOV

	if aimTarget then
		local ok, char = isValidTarget(aimTarget)
		local part = ok and getAimPart(char)
		local d = part and screenDistance(cam, part, center)
		if not part or not d or d > radius * 1.5
			or (S.aim.WallCheck and not isVisible(cam, part, char))
			or (part.Position - cam.CFrame.Position).Magnitude > S.aim.MaxDist then
			aimTarget = nil
		end
	end
	if not aimTarget or not S.aim.Sticky then
		aimTarget = findTarget(cam, center, radius)
	end
	if not aimTarget then return end

	local part = getAimPart(aimTarget.Character)
	if not part then return end

	local aimPos = part.Position + part.AssemblyLinearVelocity * S.aim.Predict
	local goal = CFrame.lookAt(cam.CFrame.Position, aimPos)
	local alpha = 1
	if S.aim.Smooth > 0 then
		alpha = 1 - math.exp(-(60 * (1 - S.aim.Smooth / 100) + 2) * dt)
	end
	cam.CFrame = cam.CFrame:Lerp(goal, alpha)
end)

