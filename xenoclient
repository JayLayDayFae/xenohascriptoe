local function applyPartTransparency(part)
	if part:IsA("BasePart") and not part:IsDescendantOf(player.Character or workspace) and part.Name ~= "KsenoPlatform" then
		if not trackedParts[part] then
			trackedParts[part] = part.Transparency
		end
		if S.misc.WallTrans then
			part.Transparency = math.max(trackedParts[part], S.misc.WallTransVal)
		end
	end
end

local function setWallTransparency(enabled, val)
	S.misc.WallTrans = enabled
	if val then S.misc.WallTransVal = val end

	if enabled then
		for _, obj in ipairs(workspace:GetDescendants()) do
			applyPartTransparency(obj)
		end
	else
		for part, orig in pairs(trackedParts) do
			if part and part.Parent then
				part.Transparency = orig
			end
		end
		table.clear(trackedParts)
	end
end

workspace.DescendantAdded:Connect(function(obj)
	if S.misc.WallTrans then
		applyPartTransparency(obj)
	end
end)

local function setGrassRemoval(enabled)
