local function setSelected(team, selected)
	selectedTeams[team] = selected or nil
	local entry = teamRows[team]
	if not entry then return end
	tween(entry.Row, quick, { BackgroundColor3 = selected and THEME.ItemSelected or THEME.Item })
	tween(entry.Stroke, quick, { Transparency = selected and 0 or 1 })
	tween(entry.Check, quick, { TextTransparency = selected and 0 or 1 })
end

