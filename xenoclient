			TextTruncate = Enum.TextTruncate.AtEnd,
		}).Parent = row

		local preview = create("Frame", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -82, 0, ROW_HEIGHT / 2),
			Size = UDim2.fromOffset(14, 14),
			BackgroundColor3 = settings.Color,
			BorderSizePixel = 0,
		}, { corner(4), stroke(Color3.new(1, 1, 1), 1, 0.6) })
		preview.Parent = row

		local check = create("TextLabel", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -58, 0, ROW_HEIGHT / 2),
			Size = UDim2.fromOffset(20, 20),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Text = "✓",
			TextColor3 = THEME.Accent,
			TextSize = 20,
			TextTransparency = isSel and 0 or 1,
		})
		check.Parent = row

		local styleBtn = create("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -8, 0, ROW_HEIGHT / 2),
			Size = UDim2.fromOffset(44, 24),
			BackgroundColor3 = isExpanded and THEME.Accent or THEME.Background,
			AutoButtonColor = false,
			Font = Enum.Font.GothamMedium,
			Text = "Style",
			TextColor3 = THEME.Text,
			TextSize = 12,
		}, { corner(7) })
		styleBtn.Parent = row

		local panel = create("Frame", {
			Position = UDim2.fromOffset(0, ROW_HEIGHT),
			Size = UDim2.new(1, 0, 0, PANEL_HEIGHT),
			BackgroundTransparency = 1,
		})
		panel.Parent = row

		create("Frame", {
			Position = UDim2.fromOffset(12, 0),
			Size = UDim2.new(1, -24, 0, 1),
			BackgroundColor3 = THEME.SubText,
			BackgroundTransparency = 0.8,
			BorderSizePixel = 0,
		}).Parent = panel

		panelLabel(panel, "Custom hue", 51)
		local hueSlider = makeSlider(panel, UDim2.fromOffset(96, 56), UDim2.new(1, -112, 0, 10),
			settings.Color:ToHSV(),
			function(a)
				settings.Color = Color3.fromHSV(a, 1, 1)
				preview.BackgroundColor3 = settings.Color
				applyTeamStyle(team)
			end, { Gradient = rainbow })

		panelLabel(panel, "Color", 12)
		for idx, color in ipairs(COLOR_PRESETS) do
			local baseX = 96 + (idx - 1) * 26
			local sw = create("TextButton", {
				Position = UDim2.fromOffset(baseX, 11),
				Size = UDim2.fromOffset(22, 22),
				BackgroundColor3 = color,
				AutoButtonColor = false,
				Text = "",
			}, { round(), stroke(Color3.new(1, 1, 1), 1, 0.6) })
			sw.Parent = panel

			sw.MouseEnter:Connect(function()
				tween(sw, quick, { Size = UDim2.fromOffset(25, 25), Position = UDim2.fromOffset(baseX - 1.5, 9.5) })
			end)
			sw.MouseLeave:Connect(function()
				tween(sw, quick, { Size = UDim2.fromOffset(22, 22), Position = UDim2.fromOffset(baseX, 11) })
			end)
			sw.MouseButton1Click:Connect(function()
				settings.Color = color
				preview.BackgroundColor3 = color
				hueSlider.Set(color:ToHSV())
				applyTeamStyle(team)
			end)
		end

		panelLabel(panel, "Transparency", 85)
		local transLabel = create("TextLabel", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -12, 0, 85),
			Size = UDim2.fromOffset(40, 20),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Text = string.format("%d%%", math.floor(settings.Transparency * 100 + 0.5)),
			TextColor3 = THEME.Accent,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Right,
		})
		transLabel.Parent = panel

		makeSlider(panel, UDim2.fromOffset(96, 90), UDim2.new(1, -156, 0, 10), settings.Transparency,
			function(a)
				settings.Transparency = math.floor(a * 100 + 0.5) / 100
				transLabel.Text = string.format("%d%%", math.floor(settings.Transparency * 100 + 0.5))
				applyTeamStyle(team)
			end, { Fill = true })

		selectBtn.MouseButton1Click:Connect(function()
			setSelected(team, not selectedTeams[team])
		end)

		styleBtn.MouseButton1Click:Connect(function()
			local open = not expandedTeams[team]
			expandedTeams[team] = open or nil
			tween(row, expandInfo, {
				Size = UDim2.new(1, 0, 0, open and (ROW_HEIGHT + PANEL_HEIGHT) or ROW_HEIGHT),
			})
			tween(styleBtn, quick, { BackgroundColor3 = open and THEME.Accent or THEME.Background })
		end)

		row.Parent = teamsPage
		teamRows[team] = { Row = row, Stroke = rowStroke, Check = check }
	end
end

