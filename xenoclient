---------------------------------------------------------------------
-- OPEN / CLOSE + DRAG
---------------------------------------------------------------------
local isOpen = true
local openPos = UDim2.fromScale(0.5, 0.5)
local morphInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local fadeOut = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function setOpen(open)
	isOpen = open
	if open then
		content.Visible = true
		tween(window, morphInfo, { Size = OPEN_SIZE, Position = openPos, AnchorPoint = Vector2.new(0.5, 0.5) })
		tween(windowCorner, morphInfo, { CornerRadius = UDim.new(0, 14) })
		tween(content, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { GroupTransparency = 0 })
	else
		tween(window, morphInfo, { Size = CLOSED_SIZE, Position = CLOSED_POS, AnchorPoint = Vector2.new(1, 0) })
		tween(windowCorner, morphInfo, { CornerRadius = UDim.new(0, 28) })
		local t = tween(content, fadeOut, { GroupTransparency = 1 })
		t.Completed:Connect(function()
			if not isOpen then content.Visible = false end
		end)
	end
end

iconBtn.MouseButton1Click:Connect(function() setOpen(not isOpen) end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.KeyCode == TOGGLE_KEY then setOpen(not isOpen) end
end)

do
	local dragging, dragStart, startPos
	header.InputBegan:Connect(function(input)
		if isOpen and (input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = true
			dragStart = input.Position
			startPos = window.Position
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			window.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
			openPos = window.Position
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

