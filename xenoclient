local function addSlider(page, label, minV, maxV, default, callback, step, suffix)
	step = step or 1
	local function fmt(v)
		local s = step < 1 and string.format("%.2f", v) or tostring(v)
		return s .. (suffix or "")
	end

	local row = create("Frame", {
		LayoutOrder = nextOrder(page),
		Size = UDim2.new(1, 0, 0, 56),
		BackgroundColor3 = THEME.Item,
		BorderSizePixel = 0,
