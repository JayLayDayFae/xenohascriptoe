-- generic 0..1 slider
local function makeSlider(parent, position, size, initial, onChange, opts)
	opts = opts or {}

	local track = create("TextButton", {
		Position = position,
		Size = size,
		BackgroundColor3 = opts.Gradient and Color3.new(1, 1, 1) or THEME.Background,
		AutoButtonColor = false,
		Text = "",
	}, { round() })
	if opts.Gradient then
		create("UIGradient", { Color = opts.Gradient }).Parent = track
	end
	track.Parent = parent

	local fill
	if opts.Fill then
		fill = create("Frame", {
			Size = UDim2.fromScale(initial, 1),
			BackgroundColor3 = THEME.Accent,
			BorderSizePixel = 0,
		}, { round() })
		fill.Parent = track
	end

	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(initial, 0.5),
		Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 2,
	}, { round(), stroke(THEME.Accent, 2, 0) })
	knob.Parent = track

	local function setVisual(v)
		v = math.clamp(v, 0, 1)
		knob.Position = UDim2.fromScale(v, 0.5)
		if fill then fill.Size = UDim2.fromScale(v, 1) end
	end

	local function fromX(x)
		local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		setVisual(a)
		onChange(a)
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			activeDrag = fromX
			fromX(input.Position.X)
		end
	end)

	return { Set = setVisual }
end

